rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ramanovsardor8@gmail.com';
    }

    // Users: users can read profiles and create/update only their own profile.
    // Admin may read/update profiles for moderation. Passwords must never be stored here.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && !('password' in request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && !('password' in request.resource.data);
      allow delete: if isAdmin();
    }

    // Jobs are public to read. Only the owner or admin can modify/delete a job.
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
    }

    // Public freelancer profiles. Existing legacy records without ownerId remain readable.
    // New/updated profiles can only be changed by their owner or admin.
    match /freelancers/{freelancerId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Chats must be tightened to participant-based access before production use.
    // Keep authenticated access for now so existing chat documents do not break.
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // Wallets and transaction history are server-managed. Clients can only read their own.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // Escrow deals: participants/admin can read. Client creates only pending_payment.
    // All subsequent state changes are server-side after payment confirmation.
    match /deals/{dealId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.clientId ||
         request.auth.uid == resource.data.freelancerId ||
         isAdmin());
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.clientId &&
        request.resource.data.status == 'pending_payment';
      allow update, delete: if isAdmin();
    }

    // Default deny: every collection not explicitly listed above is protected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
