rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Users ---
    // A password field is never allowed here under any circumstance --
    // this collection is readable by any signed-in user, so storing a
    // password here (plaintext or otherwise) would leak it to every other
    // user. The real password only ever lives inside Firebase Auth.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && !('password' in request.resource.data);
      allow update: if isSignedIn() && isOwner(userId) && !('password' in request.resource.data);
      allow delete: if false;
    }

    // --- Jobs ---
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Freelancers ---
    match /freelancers/{freelancerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Chats ---
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // --- Wallets ---
    // SECURITY: balances and transactions are READ-ONLY for clients.
    // All balance changes happen server-side in Cloud Functions (Payme webhook,
    // release-funds function) via the Admin SDK, which bypasses these rules.
    // A signed-in user can no longer edit their own balance from the browser.
    match /wallets/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow write: if false;
      }
    }

    // --- Deals (Escrow) ---
    // A client may CREATE a deal in 'pending_payment' status (before paying).
    // Every other status change (in_escrow, released, refunded, disputed) is
    // written only by Cloud Functions once a real payment event is confirmed.
    match /deals/{dealId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.freelancerId);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.clientId &&
        request.resource.data.status == 'pending_payment';
      allow update: if false;
      allow delete: if false;
    }
  }
}
